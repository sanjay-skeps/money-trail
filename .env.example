DATABASE_URL=postgresql://postgres:postgres@localhost:5432/money_trail
SESSION_SECRET=replace-this-with-at-least-32-random-characters
# SESSION_SECRET is used to derive separate access-token and refresh-token signing keys.
# Optional: protect /api/cron/daily with this bearer secret and call it once a day.
CRON_SECRET=replace-this-with-a-long-random-secret
# Optional private receipt object-store HTTP gateway. Without it, receipts are stored locally under .data/receipts.
RECEIPT_STORAGE_URL=
RECEIPT_STORAGE_TOKEN=

# "Add with AI": choose the provider, then set that provider's key (and optionally its model).
# One of: anthropic, openai, gemini
AI_PROVIDER=anthropic
# Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OpenAI (https://platform.openai.com) - used when AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# Optional, reasoning models only: none, minimal, low, medium, high
# OPENAI_REASONING_EFFORT=low
# Google Gemini (https://aistudio.google.com/apikey) - used when AI_PROVIDER=gemini; has a free tier
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest  (or gemini-flash-latest for the larger Flash model)
